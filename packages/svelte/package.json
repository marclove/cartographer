{
  "name": "@cartographer/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 runes for Cartographer behavior trees",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "svelte": "./dist/index.js",
  "peerDependencies": {
    "@cartographer/client": ">=0.1.0",
    "cartographer": ">=0.1.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@cartographer/client": "workspace:*",
    "cartographer": "workspace:*",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.2.7",
    "jsdom": "^27.0.1",
    "svelte": "^5.53.11",
    "svelte-check": "^4.4.5"
  },
  "scripts": {
    "build": "svelte-package -i src && rm -rf dist/__tests__ dist/*.test.*",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "license": "Apache-2.0"
}
