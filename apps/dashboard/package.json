{
  "name": "@cartographer/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server/server.d.ts",
      "import": "./dist/server/server.js"
    },
    "./static-dir": {
      "types": "./static-dir.d.ts",
      "import": "./static-dir.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "dev": "vite dev"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "svelte": "^5.53.11",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
